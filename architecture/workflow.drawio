        <mxCell id="3YLvYWSsD1ZXZJSxB-80-1" parent="0" value="Clinical setup" />
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-2">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-1" style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#d7dfe8;fontColor=#64748b;fontFamily=Helvetica;fontSize=13;collapsible=0;;startSize=180;" vertex="1">
            <mxGeometry height="240" width="2040" y="100" as="geometry" />
