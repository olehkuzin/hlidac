  <diagram name="Role-based workflow" id="fz74D25Lyyr2eY8-OkJk">
    <mxGraphModel dx="3593" dy="2354" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
