        <object label="&lt;b&gt;Unresolved reports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Missed · failed · partial&lt;/font&gt;" tooltip="Configured reminders/outreach and visible team tasks. Missing responses never imply absence of symptoms. No card match follows configured clarification/review/contact policy." id="3YLvYWSsD1ZXZJSxB-80-54">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-52" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aa7b16;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
