            <mxGeometry height="36" width="30" x="75" y="54" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Group template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Doctor defines&lt;/font&gt;" tooltip="Clinician defines symptoms, required questions, escalation thresholds, medication-use checks and check-in frequency. The LLM never authors clinical rules." id="3YLvYWSsD1ZXZJSxB-80-4">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="220" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Patient assignment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Review &amp; approve&lt;/font&gt;" tooltip="Combine group template with reviewed history, treatment, baseline symptoms, previous adverse events and individual restrictions. Clinician confirms before activation. Review after treatment/history changes." id="3YLvYWSsD1ZXZJSxB-80-5">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="440" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Approved schedule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Time · reminders&lt;/font&gt;" tooltip="Doctor-defined frequency; patient preferred time and timezone; bounded reminders and approved snoozes. Frequency changes require approval or an approved rule. Urgent action is never snoozed." id="3YLvYWSsD1ZXZJSxB-80-6">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="660" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Advice library&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Approved Czech&lt;/font&gt;" tooltip="Versioned cards with approver, review date, exact Czech wording, applicability, exclusions and follow-up instructions." id="3YLvYWSsD1ZXZJSxB-80-7">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1320" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Response policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Team · fallback&lt;/font&gt;" tooltip="Configure team ownership, coverage hours, delivery checks, acknowledgement deadlines and fallback contacts." id="3YLvYWSsD1ZXZJSxB-80-8">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1760" y="90" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="3YLvYWSsD1ZXZJSxB-80-9" edge="1" parent="3YLvYWSsD1ZXZJSxB-80-2" source="3YLvYWSsD1ZXZJSxB-80-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#62748b;strokeWidth=1.3;fontSize=10;fontColor=#62748b;labelBackgroundColor=#ffffff;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=6;rounded=0;" target="3YLvYWSsD1ZXZJSxB-80-5" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
