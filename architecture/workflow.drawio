          </mxCell>
        </object>
        <object label="&lt;b&gt;Review case&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Rule · trends · source&lt;/font&gt;" tooltip="Nurse queue shows patient context, reported concern/timing, provisional CTCAE grade (clinician confirms), exact triggering rule, trend, uncertainty, original statements and extracted summary. Routine cases and urgent alerts have distinct priority." id="3YLvYWSsD1ZXZJSxB-80-57">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-52" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aa7b16;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
