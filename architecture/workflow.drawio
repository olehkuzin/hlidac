              <mxPoint x="960" y="190" />
              <mxPoint x="300" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="Processing" id="3YLvYWSsD1ZXZJSxB-80-32">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#243247;" vertex="1">
            <mxGeometry height="50" width="160" x="10" y="112" as="geometry" />
          </mxCell>
        </object>
        <object label="invalid" id="3YLvYWSsD1ZXZJSxB-80-33">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#52647a;fillColor=#ffffff;strokeColor=none;" vertex="1">
            <mxGeometry height="20" width="56.1" x="601.95" y="195" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="3YLvYWSsD1ZXZJSxB-80-34" parent="0" value="Rules &amp; guidance" />
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-35">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-34" style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fillColor=#e8f5e9;swimlaneFillColor=#e8f5e9;strokeColor=#d7dfe8;fontColor=#357a47;fontFamily=Helvetica;fontSize=13;collapsible=0;;startSize=180;" vertex="1">
            <mxGeometry height="240" width="2040" y="820" as="geometry" />
          </mxCell>
        </object>
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-36">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-35" style="shape=mxgraph.office.concepts.clipboard;html=1;fillColor=#357a47;strokeColor=#357a47;" vertex="1">
            <mxGeometry height="36" width="30" x="75" y="54" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Urgent rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;met?&lt;/font&gt;" tooltip="Evaluate available validated information immediately using clinician-approved rules. Do not wait for unrelated missing answers. Reassess on clarification." id="3YLvYWSsD1ZXZJSxB-80-37">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-35" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#357a47;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="880" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Enough&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;information?&lt;/font&gt;" tooltip="Required assessment fields must be available. If not, ask targeted questions; stop prolonged questioning and keep unresolved cases visible." id="3YLvYWSsD1ZXZJSxB-80-38">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-35" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#357a47;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1100" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Routine review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;required?&lt;/font&gt;" tooltip="Deterministic rules consider baseline, treatment context, persistence and worsening across reports. Symptoms carry a provisional CTCAE grade from the approved mapping; a clinician confirms it. Status is operational urgency, not a diagnosis." id="3YLvYWSsD1ZXZJSxB-80-39">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-35" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#357a47;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1320" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Select eligible card&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Explicit rules&lt;/font&gt;" tooltip="No escalation plus sufficient assessment information is not enough by itself: advice applicability and exclusions must also match. If no card matches, follow configured clarification/review/contact policy." id="3YLvYWSsD1ZXZJSxB-80-40">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-35" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#357a47;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
