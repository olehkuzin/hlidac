          </mxCell>
        </object>
        <object label="&lt;b&gt;Urgent alert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Rule + evidence&lt;/font&gt;" tooltip="Initiate patient instructions and team alert immediately; neither waits for completion of the report or a final FHIR write. Group repeats of unresolved episodes; worsening may re-escalate." id="3YLvYWSsD1ZXZJSxB-80-41">
