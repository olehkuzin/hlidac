          </mxCell>
        </object>
        <mxCell id="3YLvYWSsD1ZXZJSxB-80-12" parent="0" value="Patient view" />
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-13">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-12" style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fillColor=#e8f4f8;swimlaneFillColor=#e8f4f8;strokeColor=#d7dfe8;fontColor=#167d9b;fontFamily=Helvetica;fontSize=13;collapsible=0;;startSize=180;" vertex="1">
            <mxGeometry height="240" width="2040" y="340" as="geometry" />
          </mxCell>
        </object>
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-14">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="shape=mxgraph.ios7.icons.smartphone;html=1;fillColor=#167d9b;strokeColor=#167d9b;;fillColor=none;strokeWidth=2;" vertex="1">
            <mxGeometry height="36" width="30" x="75" y="54" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;App check-in&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;In-app + email notice&lt;/font&gt;" tooltip="Our own accessible mobile web app, no messenger, Czech only. The check-in notice appears in the app and is mirrored to email without clinical content. Completed reports suppress reminders. Unsolicited reports satisfy a scheduled check-in only if required fields are covered within the configured window." id="3YLvYWSsD1ZXZJSxB-80-15">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#167d9b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="220" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Describe symptoms&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Text · voice · buttons&lt;/font&gt;" tooltip="Patient may report at any time. Voice, text and large buttons (no images in this version); every input has an accessible alternative (WCAG 2.2 AA). Medication-use deviations are collected where required." id="3YLvYWSsD1ZXZJSxB-80-16">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#167d9b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="440" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Answer clarification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Only what is missing&lt;/font&gt;" tooltip="Confirm consequential ambiguities, including unclear medication doses. Unknown answers remain unresolved. Replies re-enter extraction and validation." id="3YLvYWSsD1ZXZJSxB-80-17">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#167d9b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="880" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Approved guidance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Exact Czech wording&lt;/font&gt;" tooltip="Only an eligible card may be delivered. No free-form treatment recommendations, invented reassurance or prescription changes. Doctor-authored recommendations are an open point (system-design D15)." id="3YLvYWSsD1ZXZJSxB-80-18">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#167d9b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1540" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Urgent instructions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Act immediately&lt;/font&gt;" tooltip="Approved contact / emergency pathway, including 155 when applicable. Explain whether the team was notified and whether a response is expected; do not imply continuous monitoring." id="3YLvYWSsD1ZXZJSxB-80-19">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#167d9b;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="1760" y="90" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="3YLvYWSsD1ZXZJSxB-80-20" edge="1" parent="3YLvYWSsD1ZXZJSxB-80-13" source="3YLvYWSsD1ZXZJSxB-80-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#62748b;strokeWidth=1.3;fontSize=10;fontColor=#62748b;labelBackgroundColor=#ffffff;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=6;rounded=0;" target="3YLvYWSsD1ZXZJSxB-80-16" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="Patient view" id="3YLvYWSsD1ZXZJSxB-80-21">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-13" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#243247;" vertex="1">
            <mxGeometry height="50" width="160" x="10" y="112" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="3YLvYWSsD1ZXZJSxB-80-22" parent="0" value="Processing" />
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-23">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-22" style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fillColor=#fff0e6;swimlaneFillColor=#fff0e6;strokeColor=#d7dfe8;fontColor=#bd6b25;fontFamily=Helvetica;fontSize=13;collapsible=0;;startSize=180;" vertex="1">
            <mxGeometry height="240" width="2040" y="580" as="geometry" />
          </mxCell>
        </object>
        <object label="" tooltip="" id="3YLvYWSsD1ZXZJSxB-80-24">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="shape=mxgraph.ios7.icons.controls2;html=1;fillColor=#bd6b25;strokeColor=#bd6b25;;fillColor=none;strokeWidth=2;" vertex="1">
            <mxGeometry height="36" width="30" x="75" y="54" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Validate intake&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Identity · media&lt;/font&gt;" tooltip="Link the passwordless app login (accessible authentication) to the enrolled patient. Strict metadata schemas plus audio type, size and decoding checks." id="3YLvYWSsD1ZXZJSxB-80-25">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#bd6b25;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="440" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Transcribe &amp; extract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Whisper → local LLM&lt;/font&gt;" tooltip="Voice is transcribed locally; text enters extraction directly. Findings retain source statements. Absent, not mentioned and unknown remain distinct. Patient intake is separate from prescribed treatment." id="3YLvYWSsD1ZXZJSxB-80-26">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#bd6b25;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="660" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Pydantic validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Strict boundaries&lt;/font&gt;" tooltip="All structured boundaries use strict schemas. Reject invalid fields, types, units and constraints. Schema validity does not establish clinical correctness." id="3YLvYWSsD1ZXZJSxB-80-27">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#bd6b25;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="880" y="90" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Processing failure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bounded retry&lt;/font&gt;" tooltip="Retries return to intake/extraction as appropriate. Persistent failures stay unresolved and visible to the team; never become successful completion or reassurance." id="3YLvYWSsD1ZXZJSxB-80-28">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-23" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#bd6b25;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
            <mxGeometry height="80" width="160" x="220" y="90" as="geometry" />
          </mxCell>
        </object>
