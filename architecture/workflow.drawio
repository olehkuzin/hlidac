          </mxCell>
        </object>
        <object label="&lt;b&gt;Track notification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Delivered ≠ care&lt;/font&gt;" tooltip="In-app notification mirrored to email (minimal content, link back). Track delivery and acknowledgement separately. Failed delivery or overdue acknowledgement triggers configured fallback. Sending a notification never confirms that care was received." id="3YLvYWSsD1ZXZJSxB-80-56">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-52" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aa7b16;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
