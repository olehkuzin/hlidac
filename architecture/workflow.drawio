        <mxCell id="3YLvYWSsD1ZXZJSxB-80-10" edge="1" parent="3YLvYWSsD1ZXZJSxB-80-2" source="3YLvYWSsD1ZXZJSxB-80-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#62748b;strokeWidth=1.3;fontSize=10;fontColor=#62748b;labelBackgroundColor=#ffffff;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=6;rounded=0;" target="3YLvYWSsD1ZXZJSxB-80-6" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="Clinical setup" id="3YLvYWSsD1ZXZJSxB-80-11">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#243247;" vertex="1">
