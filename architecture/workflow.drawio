          </mxCell>
        </object>
        <object label="&lt;b&gt;Acknowledge &amp; assign&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Named responsibility&lt;/font&gt;" tooltip="Authorized staff accept responsibility and assign a clinician. Unresolved episode reports are grouped; worsening may trigger a renewed alert." id="3YLvYWSsD1ZXZJSxB-80-58">
          <mxCell parent="3YLvYWSsD1ZXZJSxB-80-52" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aa7b16;strokeWidth=1.5;fontColor=#243247;fontFamily=Helvetica;fontSize=12;spacing=5;;fontSize=13;spacing=6;" vertex="1">
