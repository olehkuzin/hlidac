# Copy to .env and fill in. Never commit .env.

AS_OF=2026-10-16

# memory: InMemoryStore + hand-made fixtures, no IRIS needed. iris: the team's IRIS (WP10, WP14).
STORE_BACKEND=memory

# IRIS for Health on the team's Azure VM, reached through an SSH tunnel (so the host is localhost).
# Values from the FHIR-AI-Hackathon-Kit notebooks (1.1, 2.1, 3.x).
# IRIS_USER is the app's own least-privilege account (WP10, D35), never _SYSTEM; the team shares
# its password privately. `uv run python -m hlidac.iris.setup` creates it from these two values.
IRIS_HOST=
IRIS_PORT=
IRIS_NAMESPACE=FHIRSERVER
IRIS_USER=hlidac_app
IRIS_PASSWORD=
FHIR_BASE_URL=
# Administrator: only `python -m hlidac.iris.setup` and the IRIS tests (HLIDAC_IRIS_TESTS=1) read
# these; the app never does. Leave them empty unless you run the setup or those tests.
IRIS_ADMIN_USER=
IRIS_ADMIN_PASSWORD=

# Model gateway (D5). Patient TEXT goes only to these endpoints, pseudonymised by the gateway;
# audio is transcribed only inside the app (mlx-whisper). Any other model endpoint is refused.
EXTRACTION_BACKEND=azure

# Azure OpenAI: the team's deployment from the organisers (check region and data retention)
# The resource root, e.g. https://<resource>.openai.azure.com, or an OpenAI v1 base URL ending in
# /openai/v1 (the organisers' https://<apim>.azure-api.net/openai/v1; the key goes in api-key).
# Use an EU data-zone deployment (…-dz-eu), never a global one (D39).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# 2024-08-01 or later (structured outputs); the deployment must support json_schema output.
# Leave it empty for an OpenAI v1 base URL (…/openai/v1, e.g. the organisers' API Management).
AZURE_OPENAI_API_VERSION=2024-10-21
# Reasoning models (the organisers' gpt-6 deployments) accept only temperature 1: set low, medium
# or high, and the gateway sends that instead of temperature 0 (D39). Empty: temperature 0.
AZURE_OPENAI_REASONING_EFFORT=

# Local LLM (Ollama): the switch for an on-prem deployment
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
LOCAL_EMBEDDING_MODEL=bge-m3

# Voice (WP17): mlx-whisper runs inside the app on the demo Mac (Apple Silicon); audio never leaves
# it. Unset (or not on Apple Silicon): no voice button. The model (~1.6 GB) downloads on first use;
# fetch it beforehand with `uv run python -c "import huggingface_hub as h;
# h.snapshot_download('mlx-community/whisper-large-v3-turbo')"`.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Voice backend (D52): mlx (above, Apple Silicon only) | server | elevenlabs.
#   server: our own Whisper server with the OpenAI API (e.g. speaches in a container); works in Docker.
#   elevenlabs: the ElevenLabs cloud API. Opt-in only: the patient's audio leaves our infrastructure.
VOICE_BACKEND=mlx
WHISPER_SERVER_URL=
WHISPER_SERVER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_SERVER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# Security (WP30). Signs session cookies and keys login-code hashes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset: a random key per start (everyone is logged out on restart).
SECRET_KEY=
# Secure cookies: Chrome and Firefox accept them on http://localhost. Set false only for Safari
# on http://localhost; never on a deployed server.
SESSION_HTTPS_ONLY=true

# Email. app: the app's runner sends emails from the outbox to SMTP. Keep app: it is the only email
# sender, as the IRIS production (WP11) writes only FHIR rows (D40). off: no email at all (tests only).
# Dev mail catcher: docker run -d --name mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit:v1.27
# Mailbox at http://localhost:8025
OUTBOX_RUNNER=app
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=hlidac@demo.local
# Real SMTP instead of Mailpit (D14: only with the team's OK), e.g. Gmail with an app password:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<account>, MAIL_FROM=<same account>.
# Then mail goes only to SMTP_ALLOWED_RECIPIENTS (comma-separated; required with SMTP_USER); any
# other address, like the invented @demo.local accounts, fails visibly in Unresolved. `*` sends to
# every account's address (Gmail accepts @demo.local and bounces it back to MAIL_FROM).
# MAIL_FROM may carry a display name: "Hlídač příznaků <account>"; Gmail keeps only its own address.
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOWED_RECIPIENTS=
# Care-team emails link to <APP_BASE_URL>/sestra (the queue), never to a case (WP16).
APP_BASE_URL=http://localhost:8000

# Demo panel at /demo (nurses only): move the demo clock, invite a patient to a check-in (D28).
# Turn it on for the demo laptop only, never in a hospital deployment.
DEMO_PANEL=true
DEMO_MAILBOX_URL=http://localhost:8025
# Periodic check-in invitations (D57): every N minutes of real time, each patient of the team gets
# the approved invitation, by email only to deliverable addresses (@demo.local: in the app only).
# Leave empty on laptops: only the Azure deployment sets it (a second copy sends nothing twice).
CHECKIN_INVITE_MINUTES=
CHECKIN_INVITE_TEAM=team-demo
# TEMPORARY, demo only: "Přeskočit ověření (DEMO)" on the code page logs in without the email code.
# Works only from localhost. Never turn it on anywhere else; remove after the demo.
DEMO_SKIP_LOGIN=false
